MapData.order = { "T1", "T2", "T3", "T4", "F1", "F2", "F3", "F4", "D1", "D2", "D3" }

-- The ids of one mode ("tdm" | "ffa" | "duel"), in MapData.order.
function MapData.ofMode(mode: string): { string }
	local ids = {}
	for _, id in MapData.order do
		if MapData.maps[id].mode == mode then
			table.insert(ids, id)
		end
	end
	return ids
end

return MapData
